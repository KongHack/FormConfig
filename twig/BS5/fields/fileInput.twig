{% macro render(field, multi) %}
    <fieldset>
        {% if field.label is not null %}
            <legend {{ (field.isSuppressLabel() ? 'class="visually-hidden"') }}>
                {{ field.label|raw }}
                {% if field.helpText is not null %}
                    <span class="FC_help_text tool_badge text-info" title="{{ field.helpText }}">
                        <i class="fa fa-fw fa-question-circle"></i>
                    </span>
                {% endif %}
            </legend>
            {% if field.getUnderLabelHtml() %}
                <div class="FC_under_label_html">
                    {{ field.getUnderLabelHtml()|raw }}
                </div>
            {% endif %}
        {% endif %}
        <div class="input-group">
            <label for="{{ field.id }}" tabindex="0" class="btn btn-primary" role="button" id="{{ field.id }}_btn">
                {% if field.label != '' %}
                    <span class="visually-hidden">{{ field.label }}</span>
                {% endif %}
                Browse... <input type="file" name="{{ field.name }}" class="d-none {{ field.class }}" id="{{ field.id }}" {{ multi ? 'multiple' : '' }}>
            </label>
            <label class="visually-hidden" for="{{ field.id }}_path">File Path</label>
            <input id="{{ field.id }}_path" type="text" class="form-control{{ field.errors|length > 0 ? ' is-invalid' : '' }}" readonly {{ field.getDataAttributeString()|raw }}>
        </div>
    </fieldset>

    <script type="text/javascript">
        $(function () {
            //making these keyboard accessible
            $('#{{ field.id }}_btn').on('keypress', function(e){
                if (e.keyCode === 13 || e.keyCode === 32) {
                    $('#{{ field.id }}').click();
                }
            });
            $('#{{ field.id }}').on('fileselect', function (event, numFiles, label) {
                var input = $(this).parents('.input-group').find(':text'), log = numFiles > 1 ? numFiles + ' files selected' : label;
                if (input.length) {
                    input.val(log);
                }
            });
        });
    </script>
    {% if field.getScript() is not empty %}
        <script type="text/javascript">{{ field.getScript()|raw }}</script>
    {% endif %}
{% endmacro %}
